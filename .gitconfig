[user]
    name = Lars Kristian Haga
    email = LarsKHaga@gmail.com

[alias]
    s = status
    st = status
    c = commit -m
    ca = 'commit -m; git push origin'
    ps = push origin
    pl = pull origin
    br = branch
    co = checkout
    sw = switch
    i = init
    all = add .
    allp = add . -p
    pul = pull
    pulll = pull
    diffs = diff --staged
[core]
	autocrlf = input
	editor = nano
[push]
	autoSetupRemote = true
	default = current
[pull]
	rebase = false
[init]
	defaultBranch = main
