[user]
    name = Lars Kristian Haga
    email = larskhaga@gmail.com

[alias]
    s = status
    st = status
    c = commit -m
    ca = 'commit -m; git push origin'
    ps = push origin
    pl = pull origin
    br = branch
    co = checkout
    sw = switch
    i = init
    all = add .
    allp = add . -p
    pul = pull
    pulll = pull
    diffs = diff --staged       
    git = status        
    puhs = push

[core]
        autocrlf = input
        editor = vim

[push]
        autoSetupRemote = true
        default = current

[pull]
        rebase = false

[init]
        defaultBranch = main
